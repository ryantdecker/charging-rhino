# Shared password for UI + agent API (set this on Vercel)
RHINO_PASSWORD=

# Local only — force file store. On Vercel, Redis is used when KV creds exist.
# RHINO_STORE=file

# Vercel ↔ Upstash Marketplace (prefix chosen at connect time; yours is RHINO_)
# RHINO_KV_REST_API_URL=
# RHINO_KV_REST_API_TOKEN=

# Manual Upstash / stock Vercel KV names also work
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
