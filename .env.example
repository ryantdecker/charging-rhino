# Local file store. On Vercel, leave unset — Redis is used automatically when Upstash/KV vars exist.
# RHINO_STORE=file

# Shared password for UI + agent API (set this on Vercel)
RHINO_PASSWORD=

# Upstash (manual) — or Vercel Marketplace / KV names below
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Injected by Vercel ↔ Upstash / Vercel KV integration
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
